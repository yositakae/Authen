generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Menu {
  menuId       Int     @id @default(autoincrement()) @db.UnsignedInt
  name         String  @db.VarChar(180)
  price        Decimal @db.Decimal(10, 2)
  isBestSeller Boolean @default(false)
  typeId       Int     @db.UnsignedInt
  type         Type    @relation(fields: [typeId], references: [typeId], map: "fk_menus_type")

  @@index([typeId], map: "idx_menus_typeId")
  @@map("menus")
}

model Type {
  typeId Int    @id @default(autoincrement()) @db.UnsignedInt
  name   String @unique(map: "name") @db.VarChar(120)
  menus  Menu[]

  @@map("types")
}
